# ── Base de données (PaaS externe) ──────────────────────────────────────────
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── Application ──────────────────────────────────────────────────────────────
GUI_PASSWORD=admin
SECRET_KEY=changez-moi-en-production
SESSION_INACTIVITY_MINUTES=30

# ── Examboot ─────────────────────────────────────────────────────────────────
API_KEY=

# ── X / Twitter (OAuth 1.0a) ─────────────────────────────────────────────────
X_API_CONSUMER_KEY=
X_API_CONSUMER_SECRET=
X_API_ACCESS_TOKEN=
X_API_ACCESS_TOKEN_SECRET=

# ── LinkedIn (OAuth 2.0) ──────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ORGANIZATION_URN=

# ── Google Cloud Storage (upload d'images) ───────────────────────────────────
GCS_BUCKET_NAME=exambootstorage
GCS_UPLOAD_FOLDER=img_question
# Monter le fichier JSON et indiquer son chemin ici :
GOOGLE_APPLICATION_CREDENTIALS=/app/gcs-credentials.json

# ── MCP API ───────────────────────────────────────────────────────────────────
MCP_API_TOKEN=

# ── Redis (optionnel : remplace le service redis du compose) ─────────────────
# Décommentez si vous utilisez Redis Cloud à la place du conteneur local :
# CELERY_BROKER_URL=redis://:password@host:port/0
# CELERY_RESULT_BACKEND=redis://:password@host:port/0
# JOB_STORE_URL=redis://:password@host:port/0
